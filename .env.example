DJANGO_SECRET_KEY=troque-por-segredo-longo
DEBUG=true
ALLOW_SIGNUPS=true
ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
CSRF_TRUSTED_ORIGINS=https://*.trycloudflare.com
DATABASE_URL=postgresql://transcricao:transcricao@db:5432/transcricao
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=true
PUBLIC_BASE_URL=http://localhost:8000
S3_ENABLED=false
DEV_BYPASS_PAYMENT=true
MAX_UPLOAD_BYTES=104857600
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=transcricao-privado
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=segredo-diferente-da-api-key
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Portuguese ASR, maximum chunk size and context overlap in seconds.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
TRANSCRIPTION_LANGUAGE=pt
TRANSCRIPTION_CHUNK_SECONDS=240
TRANSCRIPTION_OVERLAP_SECONDS=3
